# --- Funções auxiliares (inalteradas) ---

def discover_feature_functions(features_base_dir: Path) -> dict:
    feature_functions = {}

    logger.info(f"Procurando por módulos de feature em: {features_base_dir}")

    if not features_base_dir.is_dir():
        logger.error(f"DIRETÓRIO DE FEATURES NÃO ENCONTRADO: {features_base_dir}. Certifique-se de que a pasta 'src/features' existe.")
        return {}

    found_files = list(features_base_dir.glob('*.py'))
    logger.info(f"Arquivos .py encontrados em {features_base_dir}: {[f.name for f in found_files if not f.name.startswith('__init__')]}")


    for f in found_files:
        if f.name.startswith(('__init__', '.')): # Ignora __init__.py e arquivos ocultos
            continue

        module_name = f.stem

        spec = importlib.util.spec_from_file_location(f"src.features.{module_name}", f)
        if spec is None:
            logger.warning(f"Não foi possível criar especificação para o módulo {f}. Pulando. (Isso pode indicar um arquivo malformado ou não importável).")
            continue

        try:
            module = importlib.util.module_from_spec(spec)
            sys.modules[f"src.features.{module_name}"] = module
            spec.loader.exec_module(module)

            if hasattr(module, 'processar_dados'):
                feature_functions[module_name] = getattr(module, 'processar_dados')
                logger.info(f" -> SUCESSO: Módulo de feature '{module_name}' carregado. Função 'processar_dados' encontrada.")
            else:
                logger.warning(f"AVISO: Módulo '{module_name}' carregado, mas NÃO possui uma função 'processar_dados'.")
        except ImportError as ie:
            logger.error(f"ERRO DE IMPORTAÇÃO (ImportError): Módulo '{f.name}' ({f}) não pode ser importado. Certifique-se de que '__init__.py' existe em 'src/' e 'src/features/'. Erro: {ie}", exc_info=True)
        except Exception as e:
            logger.error(f"ERRO GERAL: Ao carregar/executar '{f.name}' (módulo '{module_name}'). Isso pode ser um erro de sintaxe no arquivo de feature. Erro: {e}", exc_info=True)

    if not feature_functions:
        logger.error(f"NENHUMA FUNÇÃO 'processar_dados' ENCONTRADA COM SUCESSO em '{features_base_dir}' após tentativas de importação.")
    return feature_functions


