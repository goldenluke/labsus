# --- Funções do script original, adaptadas para logging e retorno ---

def carregar_dados_sih(ufs: list, anos: list, cid_codes: list, task_instance=None):
    """
    Carrega e processa dados do SIH para um período e UFs específicos,
    filtrando por um prefixo de capítulo da CID-10 ou uma lista de códigos.
    """
    cid_str_log = ", ".join(cid_codes)
    message = f"Iniciando carregamento de dados do SIH para os códigos CID '{cid_str_log}' em {', '.join(ufs)} e anos {anos}."
    logger.info(message)
    if task_instance: task_instance.update_state(state='PROGRESS', meta={'progress': 10, 'message': message})

    try:
        sih_db = SIH()
        sih_db.load()

        dfs_sih = []
        total_files = 0
        for ano in anos:
            for uf in ufs:
                files_for_uf_year = sih_db.get_files(group='RD', uf=uf, year=ano)
                if files_for_uf_year:
                    total_files += len(files_for_uf_year)

        current_file_count = 0
        for ano in anos:
            for uf in ufs:
                files_for_uf_year = sih_db.get_files(group='RD', uf=uf, year=ano)
                if files_for_uf_year:
                    message = f"Baixando {len(files_for_uf_year)} arquivo(s) SIH/RD para {uf}/{ano}..."
                    logger.debug(message)
                    if task_instance:
                        # Pequeno update de progresso para download
                        progress = 10 + int((current_file_count / total_files) * 10) if total_files > 0 else 0
                        task_instance.update_state(state='PROGRESS', meta={'progress': progress, 'message': message})

                    parquet_set = sih_db.download(files_for_uf_year)
                    if isinstance(parquet_set, list):
                        dfs_sih.extend([p.to_dataframe() for p in parquet_set])
                    elif hasattr(parquet_set, "to_dataframe"):
                        dfs_sih.append(parquet_set.to_dataframe())
                    current_file_count += len(files_for_uf_year)


        if not dfs_sih:
            logger.warning("[AVISO] Nenhum arquivo do SIH foi encontrado para o período/UF especificado.")
            return pd.DataFrame()

        df_sih_full = pd.concat(dfs_sih, ignore_index=True)
        message = f"SIH: Total de {len(df_sih_full)} registros baixados para {', '.join(ufs)} nos anos {anos}."
        logger.info(message)
        if task_instance: task_instance.update_state(state='PROGRESS', meta={'progress': 25, 'message': message})


        prefixes = [code for code in cid_codes if len(code) == 1]
        full_codes = [code for code in cid_codes if len(code) >= 3]

        mask_prefix = pd.Series(False, index=df_sih_full.index)
        if prefixes:
            # Garante que DIAG_PRINC é string para usar .str.startswith
            df_sih_full['DIAG_PRINC'] = df_sih_full['DIAG_PRINC'].astype(str)
            mask_prefix = df_sih_full['DIAG_PRINC'].str.startswith(tuple(prefixes), na=False)

        mask_full = pd.Series(False, index=df_sih_full.index)
        if full_codes:
            # Garante que DIAG_PRINC é string para usar .isin
            df_sih_full['DIAG_PRINC'] = df_sih_full['DIAG_PRINC'].astype(str)
            mask_full = df_sih_full['DIAG_PRINC'].isin(full_codes)

        df_filtrado_causa = df_sih_full[mask_prefix | mask_full].copy()
        message = f"Filtrados {len(df_filtrado_causa)} registros para os códigos CID fornecidos."
        logger.info(message)
        if task_instance: task_instance.update_state(state='PROGRESS', meta={'progress': 40, 'message': message})


        # Removendo UFs não mapeadas (geralmente lixo de dados ou UFs não brasileiras)
        df_filtrado_causa['UF_RES_COD'] = df_filtrado_causa['MUNIC_RES'].str[:2].fillna('')

        mapa_uf = {
            '11': 'RO', '12': 'AC', '13': 'AM', '14': 'RR', '15': 'PA', '16': 'AP', '17': 'TO',
            '21': 'MA', '22': 'PI', '23': 'CE', '24': 'RN', '25': 'PB', '26': 'PE', '27': 'AL', '28': 'SE', '29': 'BA',
            '31': 'MG', '32': 'ES', '33': 'RJ', '35': 'SP',
            '41': 'PR', '42': 'SC', '43': 'RS',
            '50': 'MS', '51': 'MT', '52': 'GO', '53': 'DF'
        }
        df_filtrado_causa['UF_RES'] = df_filtrado_causa['UF_RES_COD'].map(mapa_uf)

        # Filtra por UF_RES mapeado e que esteja na lista de UFs solicitadas
        df_filtrado_uf = df_filtrado_causa[
            df_filtrado_causa['UF_RES'].isin(ufs)
        ].copy()
        message = f"Mantidos {len(df_filtrado_uf)} registros para residentes de {', '.join(ufs)}."
        logger.info(message)
        if task_instance: task_instance.update_state(state='PROGRESS', meta={'progress': 50, 'message': message})


        df_filtrado_uf['DT_INTER'] = pd.to_datetime(df_filtrado_uf['DT_INTER'], errors='coerce')
        df_filtrado_uf.dropna(subset=['DT_INTER'], inplace=True)

        # Usar N_AIH para contagem única de internações
        df_historico = df_filtrado_uf.groupby(pd.Grouper(key='DT_INTER', freq='W-Mon'))['N_AIH'].nunique().reset_index()
        df_historico.rename(columns={'DT_INTER': 'ds', 'N_AIH': 'y'}, inplace=True)

        logger.info("Dados agregados semanalmente com sucesso.")
        return df_historico

    except Exception as e:
        logger.error(f"ERRO CRÍTICO durante o carregamento de dados SIH: {e}", exc_info=True)
        if task_instance: task_instance.update_state(state='FAILURE', meta={'progress': 0, 'message': f"Erro ao carregar dados: {str(e)}"})
        return pd.DataFrame()


def executar_previsao(
    ufs: list,
    anos_historico: list,
    cid_codes: list,
    meses_previsao: int,
    output_dir: Path,
    task_instance=None
):
    """
    Orquestra todo o processo de previsão de internações por grupo de doenças.
    """
    cid_str_log = ", ".join(cid_codes)
    message = f"Iniciando Previsão para CID(s) '{cid_str_log}' em {', '.join(ufs)}."
    logger.info(message)
    if task_instance: task_instance.update_state(state='PROGRESS', meta={'progress': 60, 'message': message})

    df_historico = carregar_dados_sih(ufs=ufs, anos=anos_historico, cid_codes=cid_codes, task_instance=task_instance)

    if df_historico.empty or df_historico['y'].sum() == 0:
        warning_msg = f"AVISO: Não foram encontrados dados de internação para CID(s) '{cid_str_log}' nos filtros aplicados. Previsão abortada."
        logger.warning(warning_msg)
        if task_instance: task_instance.update_state(state='FAILURE', meta={'progress': 100, 'message': warning_msg})
        return None # Retorna None para indicar que a previsão não foi bem-sucedida

    df_historico['floor'] = 0
    # O 'cap' pode ser ajustado para ser mais dinâmico ou configurável
    df_historico['cap'] = df_historico['y'].max() * 1.5
    if df_historico['cap'].iloc[0] == 0: # Evitar cap zero se y.max() for 0
        df_historico['cap'] = 1 # Garante que o cap não seja zero para Prophet

    message = "Treinando o modelo Prophet com crescimento logístico..."
    logger.info(message)
    if task_instance: task_instance.update_state(state='PROGRESS', meta={'progress': 70, 'message': message})

    # Configurações do Prophet: adicione trend, yearly, weekly e daily seasonality
    modelo = Prophet(
        yearly_seasonality=True,
        weekly_seasonality=True,
        daily_seasonality=False, # Geralmente não há dados diários agregados semanalmente
        seasonality_mode='multiplicative',
        growth='logistic'
    )
    modelo.fit(df_historico)
    logger.info("Modelo treinado com sucesso.")

    periodos_futuros = int(np.ceil((meses_previsao * 30.5) / 7)) # Converter meses para semanas
    message = f"Gerando datas futuras para {periodos_futuros} semanas de previsão..."
    logger.info(message)
    if task_instance: task_instance.update_state(state='PROGRESS', meta={'progress': 80, 'message': message})

    futuro = modelo.make_future_dataframe(periods=periodos_futuros, freq='W-Mon')
    futuro['floor'] = 0
    futuro['cap'] = df_historico['cap'].iloc[0]

    message = "Realizando a previsão..."
    logger.info(message)
    if task_instance: task_instance.update_state(state='PROGRESS', meta={'progress': 90, 'message': message})

    previsao = modelo.predict(futuro)
    logger.info("Previsão concluída.")

    # Mescla com os dados históricos para ter a série completa (histórico + previsão)
    previsao_final = pd.merge(previsao, df_historico[['ds', 'y']], on='ds', how='left')

    # ⭐ TRATAMENTO DE NaN/INF ANTES DE SALVAR NO CSV ⭐
    # Converte np.inf e -np.inf para np.nan
    previsao_final = previsao_final.replace([np.inf, -np.inf], np.nan)
    # Converte todos os np.nan para None (que é serializável em JSON como null)
    previsao_final = previsao_final.where(pd.notna(previsao_final), None)

    # Constrói um nome de ficheiro único com todos os parâmetros
    output_dir.mkdir(parents=True, exist_ok=True)
    ufs_str = '_'.join(sorted(ufs)).lower()
    cid_str = '_'.join(sorted(cid_codes)).lower().replace(' ', '_')
    anos_str = '_'.join(map(str, sorted(anos_historico)))
    meses_str = f"{meses_previsao}m"

    nome_arquivo_csv = f"previsao_internacoes_{cid_str}_{ufs_str}_{anos_str}_{meses_str}.csv"
    caminho_csv = output_dir / nome_arquivo_csv

    previsao_final.to_csv(caminho_csv, sep=';', encoding='utf-8-sig', index=False)
    logger.info(f"Previsão em CSV salva em: {caminho_csv}")

    return caminho_csv # Retorna o caminho do arquivo salvo


# --- Celery Task Principal ---

@shared_task(bind=True)
def run_prediction_pipeline(self, ufs, anos_historico, cid_codes, meses_previsao, user_id): # type: ignore
    ManagedFile = apps.get_model('api', 'ManagedFile')
    User = apps.get_model(settings.AUTH_USER_MODEL)
    PredictionTaskStatus = apps.get_model('pipeline_predicao_internacoes', 'PredictionTaskStatus')

    task_id = self.request.id
    user = User.objects.get(id=user_id) if user_id else None

    task_status_entry = None

    try:
        task_status_entry, created = PredictionTaskStatus.objects.get_or_create(
            task_id=task_id,
            defaults={
                'user': user,
                'status': 'STARTED',
                'ufs': ufs,
                'anos_historico': anos_historico,
                'cid_codes': cid_codes,
                'meses_previsao': meses_previsao,
                'message': 'Pipeline de predição de internações iniciada.'
            }
        )
        if not created:
            task_status_entry.status = 'STARTED'
            task_status_entry.message = 'Pipeline de predição de internações reiniciada.'
            task_status_entry.save()

        self.update_state(state='PROGRESS', meta={'progress': 5, 'message': 'Preparando para carregar dados...'})
        logger.info(f"🚀 INICIANDO O PIPELINE DE PREDIÇÃO DE INTERNAÇÕES (Task: {task_id}) 🚀")

        # Define o diretório de saída para os resultados da predição
        prediction_output_dir = Path(settings.MEDIA_ROOT) / "processed_data" / "predicoes" / str(task_id) # Subpasta única por task_id
        prediction_output_dir.mkdir(parents=True, exist_ok=True) # Garante que o diretório exista

        # Executa a função principal de previsão
        output_csv_path = executar_previsao(
            ufs=ufs,
            anos_historico=anos_historico,
            cid_codes=cid_codes,
            meses_previsao=meses_previsao,
            output_dir=prediction_output_dir,
            task_instance=self # Passa a instância da tarefa para updates de progresso
        )

        if not output_csv_path or not output_csv_path.exists():
            raise Exception("Execução da predição não gerou o arquivo de resultados esperado.")

        self.update_state(state='PROGRESS', meta={'progress': 95, 'message': 'Registrando resultados...'})

        # Cria um ManagedFile para o arquivo de saída da predição
        relative_output_path = os.path.relpath(output_csv_path, settings.MEDIA_ROOT)

        # Antes de criar, precisamos adicionar o novo FileType em api/models.py
        # Supondo que você adicionará FileType.PREDICTION
        output_file_instance, created = ManagedFile.objects.update_or_create(
            file=relative_output_path,
            defaults={
                'uploader': user,
                'filename': output_csv_path.name,
                'description': (
                    f"Previsão de internações. "
                    f"CID: {', '.join(cid_codes)}. "
                    f"UFs: {', '.join(ufs)}. "
                    f"Anos Históricos: {', '.join(map(str, anos_historico))}. "
                    f"Previsão de {meses_previsao} meses."
                ),
                'file_type': 'PREDICTION' # NOVO TIPO DE ARQUIVO para visualizador de predição
            }
        )
        task_status_entry.status = 'SUCCESS'
        task_status_entry.message = f"Pipeline de predição concluída com sucesso. Arquivo: {output_file_instance.filename}"
        task_status_entry.output_file = output_file_instance
        task_status_entry.save()

        logger.info("🎉 FLUXO DE PREDIÇÃO DE INTERNAÇÕES CONCLUÍDO! 🎉")
        return {'status': 'SUCCESS', 'message': 'Dados de previsão gerados com sucesso!', 'output_file_id': output_file_instance.id}

    except Exception as e:
        logger.exception(f"Erro inesperado na pipeline de predição {task_id}.")
        if task_status_entry:
            task_status_entry.status = 'FAILURE'
            task_status_entry.message = f"Falha na pipeline: {str(e)}"
            task_status_entry.save()
        else:
            logger.error(f"Erro ANTES da criação do PredictionTaskStatus para task {task_id}: {e}")
        raise # Re-levanta a exceção para que Celery a marque como FAILED
